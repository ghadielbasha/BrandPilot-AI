  "rules": {
    "platform_name": {
      "english": "Use DAWLATI or Dawlati.",
      "arabic": "Use دولتي. When referring to the platform explicitly, prefer منصة «دولتي».",
      "forbidden_instruction": "Never use داولاتي, دوالتي, داولتي, or دَولتي."
    },

    "service_language": [
      "Do not describe a service as fully digital unless approved service-level evidence confirms this.",
      "Do not use apply online unless the specific service supports digital application.",
      "Do not mention online payment unless the specific service supports online payment.",
      "Do not mention request tracking unless the specific service supports request tracking."
    ],

    "general": [
      "Do not translate official platform names freely.",
      "Do not invent service terminology.",
      "Prefer approved terminology over model-generated synonyms.",
      "Do not modify the official Arabic spelling of دولتي."
    ]
  },

